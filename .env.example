# Copy this file to .env and replace the placeholders.
# .env is gitignored. Do not commit tokens, and do not paste them into the README.
# The fixture demo does not read these. Leave them unset to stay on dry-run.

# Optional. Raises the GitHub API rate limit.
# Required only when you explicitly open a draft pull request.
# Patch Patrol never merges, and dry-run stays the default.
GITHUB_TOKEN=replace-with-a-github-token

# Optional. Raises the NVD API rate limit. Public NVD requests work without it.
NVD_API_KEY=replace-with-an-nvd-api-key
